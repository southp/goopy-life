# gl-cli example configuration — dev mode out of the box
#
# Copy this file to config.toml and adjust as needed.
# Run the CLI without --prod to stay in dev mode (safe default).

base_dir        = "./test-temp"
domain          = "localhost"
life_in_days    = 7
port_range_start = 50000
port_range_end   = 51000
dev_mode        = true        # ignored by CLI; use --prod flag to switch
cors_origin     = "http://localhost:3000"
bind_address    = "127.0.0.1:8080"

# Instance caps. max_active: RAM-bound resident cap (default 10).
# max_provisioned: disk-bound total cap (default 10; kept equal to max_active
# until scale-to-zero #96 lands, which means the RAM cap is unreachable under
# these defaults). Both must be > 0, and max_active <= max_provisioned.
# See config.toml.example for the full rationale.
max_active       = 10
max_provisioned  = 10

[registry]
path = "./registry.db"

[allocator]
# Which allocator to use: "PlainDir" (plain filesystem) or "Zfs" (ZFS datasets)
kind = "PlainDir"
# pool and quota_mb are only needed for kind = "Zfs"

[provisioner]
# Which provisioner to use: "Hello" (no-op dev provisioner) or "Ghost" (real Ghost install, #18)
kind = "Hello"

[ratelimit]
# Per-IP rate limiting for the API server (gl-serv only; ignored by the CLI).
#
# Limits are keyed on the *real* client IP, resolved from nginx's X-Real-IP
# header (falling back to X-Forwarded-For, then the TCP peer address). Two
# independent GCRA buckets are used: a tighter one for the expensive
# provisioning path and a looser one for read endpoints.
#
# The whole section is optional — omit it to use the defaults shown below,
# which are sized for the 1 vCPU / 2 GB droplet. All four values must be > 0.
#
# Provisioning limit — applies to POST /goopies only.
# Default: burst of 2 spawns, then 1 more allowed every 60s per IP.
provision_burst      = 2
provision_period_secs = 60
#
# Read limit — applies to GET /goopies/:slug, /goopies/:slug/alive, /config.
# Default: burst of 30, replenishing 1 token every 2s per IP (comfortable for
# a frontend that polls the alive endpoint every couple of seconds).
read_burst      = 30
read_period_secs = 2
