# Nginx config for the apex domain goopy.life — serves local static pages
# (e.g. /expired) from deploy/pages/ on the droplet.
# Install: copy to /etc/nginx/sites-available/goopy.life
#          then: ln -s /etc/nginx/sites-available/goopy.life \
#                      /etc/nginx/sites-enabled/goopy.life
#          then: nginx -t && systemctl reload nginx
#
# Pages are deployed to /opt/goopy-life/pages/ by deploy.sh.

server {
    listen 80;
    server_name goopy.life;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name goopy.life;

    ssl_certificate     /etc/letsencrypt/live/goopy.life/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/goopy.life/privkey.pem;

    root /opt/goopy-life/pages;

    # Serve /expired → expired.html
    location = /expired {
        try_files /expired.html =404;
    }

    # Deny everything else on the apex domain
    location / {
        return 404;
    }
}
