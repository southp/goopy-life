# Nginx config for api.goopy.life — reverse-proxy to gl-serv (port 3000).
# Install: copy to /etc/nginx/sites-available/api.goopy.life
#          then: ln -s /etc/nginx/sites-available/api.goopy.life \
#                      /etc/nginx/sites-enabled/api.goopy.life
#          then: nginx -t && systemctl reload nginx

server {
    listen 80;
    server_name api.goopy.life;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name api.goopy.life;

    ssl_certificate     /etc/letsencrypt/live/goopy.life/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/goopy.life/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;

    location / {
        proxy_pass http://127.0.0.1:3000;  # port must match api_port in config.toml
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
