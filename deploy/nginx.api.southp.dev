# Nginx config for api.southp.dev — dev-environment reverse-proxy to gl-serv.
# Install: copy to /etc/nginx/sites-available/api.southp.dev
#          then: ln -s /etc/nginx/sites-available/api.southp.dev \
#                      /etc/nginx/sites-enabled/api.southp.dev
#          then: nginx -t && systemctl reload nginx

server {
    listen 80;
    server_name api.southp.dev;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name api.southp.dev;

    ssl_certificate     /etc/letsencrypt/live/southp.dev/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/southp.dev/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;

    location / {
        proxy_pass http://127.0.0.1:3000;  # port must match api_port in config.toml
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
