# Installed by deploy/push-binary.sh at /etc/systemd/system/gl-serv.service on
# every deploy. Edit it here, not there — a hand-edit on the host is overwritten
# by the next deploy.

[Unit]
Description=Goopy.Life API server
After=network.target

[Service]
User=goopy
ExecStart=/opt/goopy-life/bin/gl-serv --config /opt/goopy-life/config.toml
Restart=on-failure
RestartSec=5
WorkingDirectory=/opt/goopy-life
# Nothing environment-specific belongs in this file: it is installed verbatim on
# every host. RUST_LOG and anything else that varies lives in the per-environment
# drop-in, deploy/config/<env>.gl-serv.conf, which the deploy installs at
# /etc/systemd/system/gl-serv.service.d/deploy.conf (#139).
# No filesystem sandboxing here, deliberately.
#
# PrivateTmp/ProtectSystem/ProtectHome each give this unit a private mount
# namespace, and systemd sets that namespace up as a *slave*: it receives
# mounts from the host but never propagates its own back. ZfsAllocator
# provisions by running `sudo zfs create`, which mounts the new dataset — so
# with any of those options the dataset is mounted only inside this namespace.
# The provisioner then writes the instance tree onto that invisible mount and
# reports success, while every goopy-{slug}.service, which runs in the host
# namespace, sees a bare empty directory and dies with
# `Cannot find module index.js`. Nothing logs an error, and the instance is
# registered Done while crash-looping.
#
# MountFlags=shared does not rescue this: systemd applies it before the
# sandboxing options re-slave the namespace, so it is silently overridden.
#
# The hardening this gives up is smaller than it looks: gl-serv already writes
# /etc/systemd/system and /etc/nginx/* through `sudo tee` and runs
# `zfs create`/`zfs destroy`, all pinned in deploy/sudoers.goopy. Keeping the
# namespace out of the picture is what makes ZFS provisioning work at all.
# Restoring it means moving the mount out of this process — see issue #136.

# What is safe to keep, in the meantime.
#
# Not every hardening option needs a mount namespace. The ones below restrict
# the service through capabilities, seccomp or a UTS namespace only, so none of
# them re-slaves the mount namespace the way the three above do — systemd's own
# exec_needs_mount_namespace() (src/core/execute.c) names PrivateTmp,
# ProtectSystem, ProtectHome, ProtectKernelTunables, ProtectKernelModules and
# ProtectKernelLogs, and none of these.
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
RestrictNamespaces=yes

# Two omissions that look like oversights and are not:
#
# NoNewPrivileges=yes would break the service outright. Every privileged
# operation here runs through `sudo -n` (gl-core/src/sys_utils.rs, pinned in
# deploy/sudoers.goopy), and sudo is setuid-root, which NoNewPrivileges makes
# impossible to elevate through.
#
# ProtectKernelModules=yes and ProtectKernelLogs=yes each force a mount
# namespace — they sit in the same exec_needs_mount_namespace() condition as
# the three options this file removed, so they would reintroduce exactly the
# invisible-mount bug described above.

[Install]
WantedBy=multi-user.target
