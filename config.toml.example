# Base directory for goopy working directories
base_dir = "/opt/goopy-life/data"

# Public domain (e.g. "goopy.life" — instances get {slug}.{domain})
domain = "goopy.life"

# Email for SSL certificate registration
ssl_email = "admin@goopy.life"

# How long each goopy lives (days)
life_in_days = 7

# Which provisioner to use: "Hello" (PoC) or "Ghost" (real)
provisioner_kind = "Hello"

# Port range for goopy instances (inclusive)
port_range_start = 40000
port_range_end = 49999

# ZFS pool name (used in production; ignored in dev_mode)
zfs_pool = "goopy"

# Disk quota per instance (MB)
storage_quota_mb = 512

# Dev mode: skips systemd, nginx, and ZFS; uses plain dirs and background processes
dev_mode = false

# Path to the SQLite database file
db_path = "/opt/goopy-life/goopy.db"

# Allowed CORS origin (your Vercel frontend URL)
cors_origin = "https://goopy.life"

# Address and port for gl-serv to bind
bind_address = "0.0.0.0:3000"

# How often to sweep expired instances (seconds; default 86400 = 24h)
sweep_interval_secs = 86400
