# Base directory for goopy working directories
base_dir = "/opt/goopy-life/data"

# Public domain (e.g. "goopy.life" — instances get {slug}.{domain})
domain = "goopy.life"

# How long each goopy lives (days)
life_in_days = 7

# Port range for goopy instances (inclusive)
port_range_start = 40000
port_range_end = 49999

# Dev mode: skips systemd, nginx, and ZFS; uses plain dirs and background processes
dev_mode = false

# Allowed CORS origin (your Vercel frontend URL)
cors_origin = "https://goopy.life"

# Address and port for gl-serv to bind; also used by nginx auth_request subrequests.
#
# gl-serv must NOT be reachable directly from the internet: the per-IP rate
# limiter below trusts nginx's X-Real-IP header, which a direct client could
# forge to get a fresh bucket on every request. Bind to localhost so only nginx
# (and its auth_request subrequests) can reach it. If you must bind a public
# address, firewall this port to localhost instead.
bind_address = "127.0.0.1:3000"

# How often to sweep expired instances (seconds; default 86400 = 24h)
sweep_interval_secs = 86400

# Maximum resident (running) instances — RAM-bound cap (default 10).
# Each Ghost process is ~150–250 MB; a 2 GB droplet minus OS/nginx/gl-serv
# overhead fits ~10 (2 GB ÷ ~200 MB). Raise after a machine upgrade.
# Must be > 0 and <= max_provisioned; gl-serv refuses to start otherwise.
max_active = 10

# Maximum instances that exist on disk — disk-bound cap (default 10).
# 50 GB ÷ 512 MB per-instance quota ≈ 90 ceiling, but kept equal to max_active
# for beta because scale-to-zero (#96) hasn't landed. Raise toward the disk
# ceiling once idle instances can suspend.
#
# Failed instances count toward this cap — not because they hold resources (a
# failed spawn has already released its port and directory) but because they
# still occupy a registry row. The sweep reaps them, so a slot is held for at
# most sweep_interval_secs.
#
# NOTE: while max_active == max_provisioned the RAM cap can never trip, since
# active instances are a subset of provisioned ones and this cap is checked
# first. A default deployment therefore only ever answers "server_full", never
# "server_busy"; the latter becomes reachable once the two diverge (#96).
max_provisioned = 10

[registry]
# Registry data path
path = "/opt/goopy-life/goopy.db"

[allocator]
# Which allocator to use: "PlainDir" (plain filesystem) or "Zfs" (ZFS datasets)
kind = "Zfs"
# Storage pool name (Zfs only)
pool = "goopy"
# Disk quota per instance in MB (Zfs only)
quota_mb = 512

[provisioner]
# Which provisioner to use: "Ghost" (real Ghost instances) or "Hello" (PoC page, dev/testing)
kind = "Ghost"
# Prepared base Ghost install every instance soft-links to. Required for Ghost.
# See docs/GHOST_PROVISIONER.md for how to prepare and upgrade it.
# Must be the version-stamped install directory, never a stable symlink that
# later moves — the path is stored as given, so repointing it would drag every
# running instance onto a different Ghost.
source_dir = "/opt/goopy-life/ghost-5.87.1"
# Version of that base install; stamped onto each instance as service_version.
# Required. Bump it after upgrading — existing instances keep the version they
# were created with.
version = "5.87.1"
# Absolute path to the Node.js binary (systemd does not search PATH).
node_bin = "/usr/bin/node"
# Unprivileged user each instance's systemd unit runs as.
service_user = "goopy"

[ratelimit]
# Per-IP rate limiting for the API server (gl-serv only; ignored by the CLI).
#
# Limits are keyed on the *real* client IP, resolved from nginx's X-Real-IP
# header (falling back to X-Forwarded-For, then the TCP peer address). This
# assumes nginx is the only way to reach gl-serv — see bind_address above. Two
# independent GCRA buckets are used: a tighter one for the expensive
# provisioning path, a looser one for read endpoints, and a third sized for the
# nginx liveness subrequest, which runs far hotter than either.
#
# The whole section is optional — omit it to use the defaults shown below,
# which are sized for the 1 vCPU / 2 GB droplet. All six values must be > 0.
#
# Provisioning limit — applies to POST /goopies only.
# Default: burst of 2 spawns, then 1 more allowed every 60s per IP.
provision_burst      = 2
provision_period_secs = 60
#
# Read limit — applies to GET /goopies/:slug, /config, /capacity.
# Default: burst of 30, replenishing 1 token every 2s per IP (comfortable for
# a frontend that polls every couple of seconds).
read_burst      = 30
read_period_secs = 2
#
# Liveness limit — applies to GET /goopies/:slug/alive only.
#
# This endpoint is not browsed: nginx calls it as an auth_request subrequest
# once per HTTP request to an instance, so one page view costs as many tokens
# as the page has subresources. A Ghost admin screen pulls ~45 at once, which
# is why it needs its own budget rather than sharing the read one — and why
# exhausting it is so visible: auth_request turns the 429 into a 500 for every
# asset, and the page does not render at all.
# Default: burst of 600, replenishing 1 token every 1s per IP.
alive_burst      = 600
alive_period_secs = 1
