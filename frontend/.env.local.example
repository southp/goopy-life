# Base URL of the gl-serv API for browser-side calls (spawn / poll).
# Must keep the NEXT_PUBLIC_ prefix so Next.js exposes it to the browser.
# Point this at a running gl-serv instance. Do NOT include a trailing slash.
# In production this is set in the Vercel project settings.
NEXT_PUBLIC_GL_API_URL=http://localhost:3001

# URL of the gl-serv API used at Vercel build time to fetch GET /config.
# No NEXT_PUBLIC_ prefix — this is a server-only variable read during static generation.
# Required: the build fails if it is unset. Do NOT include a trailing slash.
# In production, set this in Vercel project settings → Environment Variables.
GL_CONFIG_API_URL=http://localhost:3001
