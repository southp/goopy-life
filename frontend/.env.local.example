# API base URL for local development.
# Point this at a running gl-serv instance.
# Do NOT include a trailing slash.
# In production this is set in the Vercel project settings.
NEXT_PUBLIC_API_URL=http://localhost:3001

# URL of the gl-serv API used at Vercel build time.
# No NEXT_PUBLIC_ prefix — this is a server-only variable read during static generation.
# In production, set this in Vercel project settings → Environment Variables.
API_URL=http://localhost:3001
